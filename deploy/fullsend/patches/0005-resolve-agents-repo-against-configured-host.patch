 // from the agents repository. It is a var (not const) to allow test overrides.
 var defaultAgentsRepoURLPrefix = "https://raw.githubusercontent.com/fullsend-ai/agents/"
 
+// agentsRepoRawURLPrefix returns the base URL to fetch agent harnesses from.
+//
+// github.com serves raw file bytes from a separate hostname. An enterprise
+// install has no second hostname and serves them from the appliance itself,
+// at <host>/<owner>/<repo>/raw/<ref>/<path>. Addressing raw.githubusercontent.com
+// by name therefore leaves the appliance, and the credential presented is not
+// valid wherever it lands.
+//
+// GITHUB_SERVER_URL is the standard Actions variable naming the host the
+// workflow is running against, so it is what decides. Anything on github.com
+// keeps the public host, so behaviour there is unchanged.
+func agentsRepoRawURLPrefix() string {
+	server := strings.TrimSpace(os.Getenv("GITHUB_SERVER_URL"))
+	if server == "" {
+		return defaultAgentsRepoURLPrefix
+	}
+	host := server
+	if parsed, err := url.Parse(server); err == nil && parsed.Host != "" {
+		host = parsed.Host
+	}
+	if host == "github.com" || strings.HasSuffix(host, ".github.com") {
+		return defaultAgentsRepoURLPrefix
+	}
+	return strings.TrimRight(server, "/") + "/" +
+		defaultAgentsRepoOwner + "/" + defaultAgentsRepoName + "/raw/"
+}
+
 // defaultAgentsRepoKnownAgents lists first-party agents available in the
