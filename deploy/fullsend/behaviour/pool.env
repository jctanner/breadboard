# The behaviour-test pool on the GitHub emulator: one organisation with
# BT_POOL_SIZE slot repositories, test-repo-01 ... test-repo-NN, which the
# suite creates and deletes as it leases them (ENVIRONMENT=external, patch
# 0018). The organisation name is fixed by the suite's stage layout.
#
# The mint must allow the organisation and every slot as a workflow host
# repository, because a vendored install runs reusable workflows from the
# slot itself. mint-pool.py writes both into
# deploy/k8s/24-fullsend-mint-dev.yaml from this file; change the size here,
# then run `make bt-seed`.
BT_POOL_ORG=halfsend
BT_POOL_SIZE=4
