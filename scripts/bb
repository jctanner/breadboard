def main() -> None:
    setup_env()
    args = sys.argv[1:]

    # Parse command
    if not args:
        domain = resolve_domain()
        cmd_home(domain)
        return

    # Check root flags
    if args[0].startswith("-"):
        flag = args[0]
        if flag in ("--version", "-v", "-V"):
            print(VERSION)
            sys.exit(0)
        elif flag == "--skill":
            print(SKILL_DOC.strip())
            sys.exit(0)
        elif flag in ("--help", "-h"):
            print_help("bb")
            sys.exit(0)
        elif flag == "--domain":
            if len(args) < 2 or args[1].startswith("-"):
                error_exit(
                    "usage",
                    "flag --domain requires a value for `bb`",
                    "valid flags for `bb`: --skill, --domain (--help always allowed)",
                    exit_code=2,
                )
            domain = resolve_domain(args[1])
            cmd_home(domain)
            return
        else:
            error_exit(
                "usage",
                f"unknown flag {flag} for `bb`",
                "valid flags for `bb`: --skill, --domain (--help always allowed)",
                exit_code=2,
            )

    cmd = args[0]
    if cmd not in VALID_SUBCOMMANDS:
        error_exit(
            "usage",
            f"unknown subcommand `{cmd}`",
            "valid subcommands: status, runs, logs, tickets, openshell, seed (--help always allowed)",
            exit_code=2,
        )

    # Subcommand flag and argument parsing
    allowed_flags = VALID_FLAGS[cmd]
    valid_flags_hint = ", ".join(allowed_flags) + " (--help always allowed)"

    sub_args = args[1:]
    parsed_flags: Dict[str, str] = {}
    positional: List[str] = []

    i = 0
    while i < len(sub_args):
        arg = sub_args[i]
        if arg in ("--help", "-h"):
            print_help(cmd)
            sys.exit(0)
        elif arg.startswith("-"):
            if arg not in allowed_flags:
                error_exit(
                    "usage",
                    f"unknown flag {arg} for `{cmd}`",
                    f"valid flags for `{cmd}`: {valid_flags_hint}",
                    exit_code=2,
                )
            if arg in FLAGS_WITH_VALUES:
                if i + 1 >= len(sub_args) or sub_args[i + 1].startswith("-"):
                    error_exit(
                        "usage",
                        f"flag {arg} requires a value for `{cmd}`",
                        f"valid flags for `{cmd}`: {valid_flags_hint}",
                        exit_code=2,
                    )
                parsed_flags[arg] = sub_args[i + 1]
                i += 1
            else:
                parsed_flags[arg] = "true"
        else:
            positional.append(arg)
        i += 1

    domain = resolve_domain(parsed_flags.get("--domain"))

    if cmd == "status":
        cmd_status(domain)
    elif cmd == "runs":
        repo_arg = parsed_flags.get("--repo", "fullsend-dev/triage-target")
        limit_arg = parsed_flags.get("--limit", "10")
        cmd_runs(domain, repo_arg, limit_arg)
    elif cmd == "logs":
        if not positional:
            error_exit(
                "usage",
                "missing required argument <run_id> for `logs`",
                "usage: ./scripts/bb logs <run_id> [--repo <repo>] [--job <name>] [--full]",
                exit_code=2,
            )
        run_id_str = positional[0]
        repo_arg = parsed_flags.get("--repo", "")
        job_filter = parsed_flags.get("--job")
        full = "--full" in parsed_flags
        cmd_logs(domain, run_id_str, repo_arg, job_filter, full)
    elif cmd == "tickets":
        source_arg = parsed_flags.get("--source")
        limit_arg = parsed_flags.get("--limit", "20")
        cmd_tickets(domain, source_arg, limit_arg)
    elif cmd == "openshell":
        action = positional[0] if positional else "status"
        cmd_openshell(domain, action)
    elif cmd == "seed":
        if not positional:
            error_exit(
                "usage",
                "missing seed target for `seed`",
                "valid seed targets: demo, cve, conformance",
                exit_code=2,
            )
        target = positional[0]
        cmd_seed(domain, target)


if __name__ == "__main__":
    main()
