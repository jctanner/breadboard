+  local base rest
+  base="$(_github_base_url)" || return 1
+  rest="${PR_URL#"${base}/"}"
+  if [[ "${rest}" == "${PR_URL}" ]] || \
+     [[ ! "${rest}" =~ ^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+/pull/[0-9]+$ ]]; then
     echo "ERROR: PR_URL does not match expected GitHub pattern: $(_gha_sanitize "${PR_URL}")" >&2
     return 1
