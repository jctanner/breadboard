+	"github.com/fullsend-ai/fullsend/internal/harness"
+	"github.com/fullsend-ai/fullsend/internal/ui"
+)
+
+func TestAgentsRepoRawURLPrefix(t *testing.T) {
+	for name, tc := range map[string]struct {
+		server string
+		want   string
+	}{
+		"unset":            {"", defaultAgentsRepoURLPrefix},
+		"github.com":       {"https://github.com", defaultAgentsRepoURLPrefix},
+		"github.com slash": {"https://github.com/", defaultAgentsRepoURLPrefix},
+		"enterprise":       {"https://ghe.example.internal/", "https://ghe.example.internal/fullsend-ai/agents/raw/"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			t.Setenv("GITHUB_SERVER_URL", tc.server)
+			assert.Equal(t, tc.want, agentsRepoRawURLPrefix())
+		})
+	}
+}
+
+// The online fallback pins harnesses under agentsRepoRawURLPrefix, so on an
+// enterprise forge the offline scan must look for that prefix too; matching
+// only github.com's would never find what the previous online run cached.
+func TestTryAgentsRepoFallback_OfflineCacheHitOnEnterpriseForge(t *testing.T) {
+	t.Setenv("GITHUB_SERVER_URL", "https://ghe.example.internal")
+	prefix := agentsRepoRawURLPrefix()
+	root := t.TempDir()
+	sha := strings.Repeat("d", 40)
+	rawURL := prefix + sha + "/harness/triage.yaml"
+	content := []byte("role: triage\n")
+	require.NoError(t, fetch.CachePut(root, rawURL, content))
+
+	var out bytes.Buffer
+	opts := harness.ComposeOpts{
+		WorkspaceRoot: root,
+		FetchPolicy:   fetch.FetchPolicy{Offline: true},
+		OrgAllowlist:  []string{prefix},
+	}
+	client := noGetRefClient{FakeClient: forge.NewFakeClient(), t: t}
+
+	_, deps, ok := tryAgentsRepoFallback(context.Background(), "Triage", client, opts, ui.New(&out))
+	require.True(t, ok, "expected offline cache hit; output: %s", out.String())
+	require.Len(t, deps, 1)
+	assert.Equal(t, rawURL, deps[0].URL)
+	assert.Contains(t, out.String(), sha[:12])
+}
+
+func TestRouteHarnessLabel_AgentsRepoOnEnterpriseForge(t *testing.T) {
+	t.Setenv("GITHUB_SERVER_URL", "https://ghe.example.internal")
+	cfg := config.NewPerRepoConfig(nil, "fullsend-ai/demo")
+	sha := strings.Repeat("e", 40)
+	deps := []harness.Dependency{{URL: agentsRepoRawURLPrefix() + sha + "/harness/triage.yaml"}}
+	assert.Equal(t, "agents@"+sha[:12], routeHarnessLabel(cfg, "triage", deps))
+}
+
+// The dispatch route and lint resolve the agents repository through the same
+// fallback as fullsend run, so they must build their client the same way.
+func TestAgentsFallbackClientsHonourTheConfiguredAPIURL(t *testing.T) {
+	t.Setenv("GITHUB_API_URL", "https://ghe.example.internal/api/v3")
+	for _, token := range []string{"", "token"} {
+		assert.Equal(t, "https://ghe.example.internal/api/v3", newGitHubLiveClient(token, "").BaseURL())
+	}
+}
