+// defaultBehaviourEnvFile is the harness environment file the sandbox is given
+// during setup: env.sandbox values plus everything host_files contributed.
+var defaultBehaviourEnvFile = sandbox.SandboxWorkspace + "/.env"
+
+// withHarnessEnv prefixes a behaviour command so it runs with the harness
+// environment loaded.
+//
+// Every behaviour operation goes through sandbox.Exec, which starts a fresh
+// shell that inherits nothing from earlier calls. The harness environment is
+// not process state in the sandbox; it is a file, and the real runtimes source
+// it when they launch — see buildRunCommand for the Claude runtime and
+// checkSandboxGitHubConnectivity for the GitHub pre-flight. A behaviour
+// operation that skips that step sees none of it, so assert_env reports a
+// correctly delivered variable as unset and any operation needing a credential
+// or a PATH entry from the harness fails for a reason unrelated to what it was
+// checking.
+//
+// A missing or unreadable file is reported as itself rather than tolerated. If
+// the harness environment is absent the scenario is not exercising what it
+// claims to, and silently continuing would turn that into a confusing failure
+// attributed to the operation.
+func (r DummyRuntime) withHarnessEnv(command string) string {
+	envFile := r.envFile()
+	quoted := shellQuote(envFile)
+	return fmt.Sprintf(
+		"if [ ! -r %s ]; then echo 'harness environment file not readable: %s' >&2; exit 1; fi; . %s; %s",
+		quoted, envFile, quoted, command,
+	)
+}
