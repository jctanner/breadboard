+
+func TestParseRawContentURLAcceptsTheEnterpriseLayout(t *testing.T) {
+	t.Setenv("GITHUB_SERVER_URL", "https://forge.internal")
+
+	info, err := ParseRawContentURL(
+		"https://forge.internal/acme/widgets/raw/abc123/skills/triage/SKILL.md",
+	)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if info.Owner != "acme" || info.Repo != "widgets" {
+		t.Fatalf("got owner=%q repo=%q", info.Owner, info.Repo)
+	}
+	if info.Ref != "abc123" {
+		t.Fatalf("got ref=%q, want abc123", info.Ref)
+	}
+	if info.Path != "skills/triage/SKILL.md" {
+		t.Fatalf("got path=%q", info.Path)
+	}
+}
+
+func TestParseRawContentURLStillAcceptsThePublicHost(t *testing.T) {
+	t.Setenv("GITHUB_SERVER_URL", "https://forge.internal")
+
+	info, err := ParseRawContentURL(
+		"https://raw.githubusercontent.com/acme/widgets/abc123/a/b.md",
+	)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if info.Ref != "abc123" || info.Path != "a/b.md" {
+		t.Fatalf("got ref=%q path=%q", info.Ref, info.Path)
+	}
+}
+
+func TestParseRawContentURLRejectsAnUnconfiguredHost(t *testing.T) {
+	t.Setenv("GITHUB_SERVER_URL", "https://forge.internal")
+
+	if _, err := ParseRawContentURL(
+		"https://elsewhere.invalid/acme/widgets/raw/abc123/a.md",
+	); err == nil {
+		t.Fatal("a host that is neither the public one nor the configured forge must be refused")
+	}
+}
+
+func TestParseRawContentURLRequiresTheRawSegmentOnTheForge(t *testing.T) {
+	t.Setenv("GITHUB_SERVER_URL", "https://forge.internal")
+
+	// Without the segment this would silently read the ref as "abc123" from
+	// the wrong position and fetch a path that does not exist.
+	if _, err := ParseRawContentURL(
+		"https://forge.internal/acme/widgets/abc123/a.md",
+	); err == nil {
+		t.Fatal("the enterprise layout must require its /raw/ segment")
+	}
+}
+
+func TestEnterpriseRawURLClonesFromTheForgeNotGitHub(t *testing.T) {
+	t.Setenv("GITHUB_SERVER_URL", "https://forge.internal")
+
+	info, err := ParseRawContentURL(
+		"https://forge.internal/acme/widgets/raw/abc123/scripts",
+	)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if got, want := info.CloneURL(), "https://forge.internal/acme/widgets.git"; got != want {
+		t.Fatalf("CloneURL() = %q, want %q", got, want)
+	}
+}
+
+func TestPublicRawURLStillClonesFromGitHub(t *testing.T) {
+	t.Setenv("GITHUB_SERVER_URL", "https://forge.internal")
+
+	info, err := ParseRawContentURL(
+		"https://raw.githubusercontent.com/acme/widgets/abc123/scripts",
+	)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if got, want := info.CloneURL(), "https://github.com/acme/widgets.git"; got != want {
+		t.Fatalf("CloneURL() = %q, want %q", got, want)
+	}
+}
