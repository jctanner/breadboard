diff --git a/pkg/behaviourtest/steps/raw_url.go b/pkg/behaviourtest/steps/raw_url.go
new file mode 100644
index 000000000..58be3e233
--- /dev/null
+++ b/pkg/behaviourtest/steps/raw_url.go
@@ -0,0 +1,46 @@
+package steps
+
+import (
+	"fmt"
+	"net/url"
+	"os"
+	"strings"
+)
+
+// rawContentURL is the URL a remote harness or base is fetched from: the
+// public raw host on github.com, or, on the forge GITHUB_SERVER_URL names
+// when that is not github.com (an enterprise server or an emulator), the
+// appliance's own raw path. The CLI under test parses both forms
+// (forge.ParseRawContentURL).
+//
+//	https://raw.githubusercontent.com/{owner}/{repo}/{ref}/{path}
+//	https://{host}/{owner}/{repo}/raw/{ref}/{path}
+func rawContentURL(owner, repo, ref, filePath string) string {
+	if server := configuredForgeServer(); server != "" {
+		return fmt.Sprintf("%s/%s/%s/raw/%s/%s", server, owner, repo, ref, filePath)
+	}
+	return fmt.Sprintf("https://raw.githubusercontent.com/%s/%s/%s/%s", owner, repo, ref, filePath)
+}
+
+// rawContentPrefix is the allowed_remote_resources entry covering every
+// rawContentURL of owner/repo.
+func rawContentPrefix(owner, repo string) string {
+	if server := configuredForgeServer(); server != "" {
+		return fmt.Sprintf("%s/%s/%s/", server, owner, repo)
+	}
+	return fmt.Sprintf("https://raw.githubusercontent.com/%s/%s/", owner, repo)
+}
+
+// configuredForgeServer returns GITHUB_SERVER_URL without a trailing slash
+// when it names a forge other than github.com, and "" otherwise.
+func configuredForgeServer() string {
+	server := strings.TrimRight(strings.TrimSpace(os.Getenv("GITHUB_SERVER_URL")), "/")
+	if server == "" {
+		return ""
+	}
+	parsed, err := url.Parse(server)
+	if err != nil || parsed.Hostname() == "" || strings.EqualFold(parsed.Hostname(), "github.com") {
+		return ""
+	}
+	return server
+}
