+func TestPrivateHostsIsAnExceptionListNotASwitch(t *testing.T) {
+	// Only the named host is exempt; every other host is still validated.
+	if !hostAllowsPrivate("forge.internal", []string{"forge.internal"}) {
+		t.Fatal("the named host should be exempt")
+	}
+	if hostAllowsPrivate("other.internal", []string{"forge.internal"}) {
+		t.Fatal("an unnamed host must still be validated")
+	}
+	if hostAllowsPrivate("evil.forge.internal", []string{"forge.internal"}) {
+		t.Fatal("matching must be exact: a subdomain is a different host")
+	}
+	if hostAllowsPrivate("forge.internal", nil) {
+		t.Fatal("no exemption without an explicit list")
+	}
+	if !hostAllowsPrivate("FORGE.internal", []string{"forge.internal"}) {
+		t.Fatal("hostnames are case-insensitive")
+	}
+}
+
+func TestDefaultPrivateHostsRequiresBothOptInAndAForge(t *testing.T) {
+	cases := []struct {
+		name, optIn, server string
+		want                []string
+	}{
+		{"neither", "", "", nil},
+		{"opt-in without a forge", "1", "", nil},
+		{"forge without opt-in", "", "https://forge.internal", nil},
+		{"both", "1", "https://forge.internal", []string{"forge.internal"}},
+		{"github.com is never exempt", "1", "https://github.com", nil},
+		{"a github.com subdomain is never exempt", "1", "https://foo.github.com", nil},
+		{"anything but 1 is not opting in", "true", "https://forge.internal", nil},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv(allowPrivateForgeEnv, tc.optIn)
+			t.Setenv("GITHUB_SERVER_URL", tc.server)
+			got := defaultPrivateHosts()
+			if len(got) != len(tc.want) {
+				t.Fatalf("got %v, want %v", got, tc.want)
+			}
+			for i := range got {
+				if got[i] != tc.want[i] {
+					t.Fatalf("got %v, want %v", got, tc.want)
+				}
+			}
+		})
+	}
+}
+
+func TestAPrivateAddressIsStillRefusedForAnUnexemptedHost(t *testing.T) {
+	policy := DefaultPolicy
+	policy.AllowedDomains = []string{"localhost"}
+	policy.PrivateHosts = []string{"some.other.host"}
+	_, err := FetchURL(context.Background(), "https://localhost/x", policy)
+	if !errors.Is(err, errInternalIP) {
+		t.Fatalf("expected an internal-IP refusal, got %v", err)
+	}
+}
