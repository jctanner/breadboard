+
+// scriptableOpenshell writes a fake "openshell" whose provider-profile
+// delete and import outcomes are controlled by environment variables, so a
+// test can reproduce a gateway that refuses to delete a profile still in use.
+func scriptableOpenshell(t *testing.T, binDir, logPath string) {
+	t.Helper()
+	script := "#!/bin/sh\n" +
+		"echo \"$@\" >> " + shellQuote(logPath) + "\n" +
+		"case \"$3\" in\n" +
+		"  delete)\n" +
+		"    if [ -n \"${FAKE_DELETE_FAILS:-}\" ]; then\n" +
+		"      echo 'rpc error: code = FailedPrecondition desc = profile is referenced by a sandbox' >&2\n" +
+		"      exit 1\n" +
+		"    fi\n" +
+		"    exit 0 ;;\n" +
+		"  import)\n" +
+		"    if [ -n \"${FAKE_IMPORT_EXISTS:-}\" ]; then\n" +
+		"      echo \"custom provider profile 'probe' already exists\" >&2\n" +
+		"      exit 1\n" +
+		"    fi\n" +
+		"    exit 0 ;;\n" +
+		"esac\n" +
+		"exit 0\n"
+	require.NoError(t, os.WriteFile(filepath.Join(binDir, "openshell"), []byte(script), 0o755))
+}
+
+func importProfileFixture(t *testing.T) (profilePath, logPath string) {
+	t.Helper()
+	// os.TempDir() honours TMPDIR, which is where the hash cache and lock
+	// live; isolate them so these tests cannot see each other's state.
+	t.Setenv("TMPDIR", t.TempDir())
+	dir := t.TempDir()
+	profilePath = filepath.Join(dir, "probe.yaml")
+	require.NoError(t, os.WriteFile(profilePath, []byte("id: probe\nbinaries:\n  - '**/claude'\n"), 0o644))
+	binDir := t.TempDir()
+	logPath = filepath.Join(binDir, "openshell.log")
+	scriptableOpenshell(t, binDir, logPath)
+	t.Setenv("PATH", binDir+string(os.PathListSeparator)+os.Getenv("PATH"))
+	return profilePath, logPath
+}
+
+// A gateway refuses to delete a profile a live sandbox still references. The
+// import is then refused as already existing, and the gateway keeps serving
+// its previous copy. Treating that as success and caching the new hash makes
+// it permanent: every later run takes the fast path and reports success while
+// the profile is never replaced.
+func TestImportProfile_DeleteRefusedAndAlreadyExistsIsNotSuccess(t *testing.T) {
+	profilePath, _ := importProfileFixture(t)
+	t.Setenv("FAKE_DELETE_FAILS", "1")
+	t.Setenv("FAKE_IMPORT_EXISTS", "1")
+
+	err := ImportProfile(context.Background(), "probe", profilePath)
+	require.Error(t, err, "a profile that was never replaced must not report success")
+	assert.Contains(t, err.Error(), "could not be replaced")
+	assert.Contains(t, err.Error(), "FailedPrecondition", "the delete failure is the reason and must be reported")
+	assert.Contains(t, err.Error(), "provider profile update", "the error should name the supported way out")
+
+	_, statErr := os.Stat(profileFileCachePath("probe"))
+	assert.True(t, os.IsNotExist(statErr),
+		"the hash cache must not be written, or every later run skips the import and reports success")
+}
+
+// The same "already exists" response is benign when the delete succeeded: a
+// parallel process imported the same file, so the gateway holds this content.
+func TestImportProfile_AlreadyExistsAfterSuccessfulDeleteIsARace(t *testing.T) {
+	profilePath, _ := importProfileFixture(t)
+	t.Setenv("FAKE_IMPORT_EXISTS", "1")
+
+	require.NoError(t, ImportProfile(context.Background(), "probe", profilePath))
+	_, statErr := os.Stat(profileFileCachePath("probe"))
+	assert.NoError(t, statErr, "a genuine parallel import should still be cached")
+}
+
+func TestImportProfile_CleanImportCachesAndSkipsOnSecondCall(t *testing.T) {
+	profilePath, logPath := importProfileFixture(t)
+
+	require.NoError(t, ImportProfile(context.Background(), "probe", profilePath))
+	first, err := os.ReadFile(logPath)
+	require.NoError(t, err)
+	require.NoError(t, ImportProfile(context.Background(), "probe", profilePath))
+	second, err := os.ReadFile(logPath)
+	require.NoError(t, err)
+	assert.Equal(t, string(first), string(second), "an unchanged profile must not be reimported")
+}
