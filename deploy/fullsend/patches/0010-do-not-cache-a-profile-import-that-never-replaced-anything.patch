--- a/internal/sandbox/sandbox.go
+++ b/internal/sandbox/sandbox.go
@@ -206,8 +206,12 @@ func inGitDir(path, root string) bool {
 // the import if the winner already wrote the cache.
 //
 // When content has changed (hash mismatch or no cache), the existing profile
-// is deleted and reimported. If the reimport fails because a parallel process
-// already imported it, the error is treated as success.
+// is deleted and reimported. A reimport refused with "already exists" is
+// treated as success only when the delete succeeded, which means a parallel
+// process imported the same file. When the delete failed the gateway still
+// holds its previous copy, so the import is reported as a failure and the
+// cache is left alone — caching there would make every later run skip the
+// import and report success against a profile that was never replaced.
 func ImportProfile(ctx context.Context, id, profilePath string) error {
 	currentHash, err := hashProfileFile(profilePath)
 	if err != nil {
@@ -250,9 +254,11 @@ func ImportProfile(ctx context.Context, id, profilePath string) error {
 		}
 	}
 
-	// Best-effort delete so content changes propagate.
+	// Delete so content changes propagate. The outcome decides how to read
+	// an "already exists" response from the import below, so it is kept
+	// rather than discarded.
 	delCtx, delCancel := context.WithTimeout(ctx, providerTimeout)
-	exec.CommandContext(delCtx, "openshell", "provider", "profile", "delete", id).CombinedOutput() //nolint:errcheck
+	delOut, delErr := exec.CommandContext(delCtx, "openshell", "provider", "profile", "delete", id).CombinedOutput()
 	delCancel()
 
 	importCtx, importCancel := context.WithTimeout(ctx, providerTimeout)
@@ -262,7 +268,34 @@ func ImportProfile(ctx context.Context, id, profilePath string) error {
 	if err != nil {
 		outStr := strings.ToLower(string(out))
 		if strings.Contains(outStr, "already exists") {
-			// A parallel process imported the profile — safe to continue.
+			if delErr != nil {
+				// The profile was not replaced and the gateway still holds
+				// whatever it held before, which may be older than this file.
+				//
+				// Caching the new hash here is what made this permanent: every
+				// later run takes the fast path, skips the import, and reports
+				// success while the gateway keeps serving a stale profile. A
+				// profile is a sandbox's network and binary policy, so the
+				// visible symptom is an agent denied access it was granted in
+				// the file — with nothing anywhere mentioning the profile.
+				//
+				// The gateway refuses to delete a profile that a live sandbox
+				// still references, so this is reachable on any shared gateway
+				// rather than being a rare race.
+				return fmt.Errorf(
+					"profile %q could not be replaced: deleting it failed and importing it was refused because it already exists, "+
+						"so the gateway is still serving its previous copy.\n"+
+						"delete error: %v\ndelete output: %s\nimport output: %s\n"+
+						"Update it in place instead: openshell provider profile export %s > /tmp/%s.yaml, "+
+						"copy the resource_version from that export into %s, then "+
+						"openshell provider profile update --file %s %s",
+					id, delErr, bytes.TrimSpace(delOut), bytes.TrimSpace(out),
+					id, id, filepath.Base(profilePath), profilePath, id,
+				)
+			}
+			// The delete succeeded and the import lost a race with a parallel
+			// process importing the same file, so the gateway holds this
+			// content either way.
 			os.WriteFile(cachePath, []byte(currentHash), 0o600) //nolint:errcheck
 			return nil
 		}
