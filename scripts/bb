RHEA_HOST = os.environ.get("RHEA_HOST", "mhild@100.89.90.31")


def setup_env() -> None:
    rhea_kube = os.path.expanduser("~/.kube/rhea.yaml")
    if "KUBECONFIG" not in os.environ and os.path.exists(rhea_kube):
        os.environ["KUBECONFIG"] = rhea_kube


def resolve_domain(cli_domain: Optional[str] = None) -> str:
    if cli_domain:
        return cli_domain.strip(".")
    if "BREADBOARD_DOMAIN" in os.environ and os.environ["BREADBOARD_DOMAIN"].strip():
        return os.environ["BREADBOARD_DOMAIN"].strip().strip(".")
    rhea_kube = os.path.expanduser("~/.kube/rhea.yaml")
    if os.path.exists(rhea_kube):
        return "bb.internal"
    try:
        ctx = ssl._create_unverified_context()
        req = urllib.request.Request("https://dashboard.bb.internal", method="HEAD")
        with urllib.request.urlopen(req, context=ctx, timeout=1):
            return "bb.internal"
    except Exception:
        pass
    return "local"


def get_ssl_context() -> ssl.SSLContext:
    ca_path = "/tmp/rhea-ca.crt"
    if os.path.exists(ca_path):
        try:
            ctx = ssl.create_default_context(cafile=ca_path)
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
            return ctx
        except Exception:
            pass
    return ssl._create_unverified_context()


def error_exit(code: str, message: str, hint: str, exit_code: int = 1) -> None:
    print("error{code,message,hint}:")
    print(f"  {code},{message},{hint}")
    sys.exit(exit_code)


def toon_val(val: Any) -> str:
    if val is None:
        return ""
    s = str(val)
    if "," in s or '"' in s or "\n" in s or s.startswith(" ") or s.endswith(" "):
        escaped = s.replace('"', '""').replace("\n", " ")
        return f'"{escaped}"'
    return s


def get_thermal() -> Tuple[str, str]:
    try:
        proc = subprocess.run(
            [
                "ssh",
                "-o",
                "BatchMode=yes",
                "-o",
                "ConnectTimeout=2",
                RHEA_HOST,
                "cat /sys/class/hwmon/hwmon*/temp*_input 2>/dev/null || sensors 2>/dev/null",
            ],
            capture_output=True,
            text=True,
            timeout=3,
        )
        if proc.returncode == 0 and proc.stdout.strip():
            temps = [
                float(tok) / 1000.0
                for tok in proc.stdout.strip().split()
                if tok.isdigit()
            ]
            if temps:
                max_t = max(temps)
                status = "ok"
                if max_t >= 90.0:
                    status = "critical"
                elif max_t >= 80.0:
                    status = "warning"
                return f"{max_t:.1f}", status
    except Exception:
        pass
    return "n/a", "unknown"


def get_workloads() -> Tuple[int, int, List[Dict[str, str]]]:
    try:
        proc = subprocess.run(
            ["kubectl", "get", "pods", "-A", "-o", "json"],
            capture_output=True,
            text=True,
            timeout=8,
        )
        if proc.returncode == 0:
            data = json.loads(proc.stdout)
            items = data.get("items", [])
            running = 0
            pods = []
            for p in items:
                ns = p["metadata"].get("namespace", "")
                name = p["metadata"].get("name", "")
                phase = p.get("status", {}).get("phase", "Unknown")
                cstatuses = p.get("status", {}).get("containerStatuses", [])
                ready_count = sum(1 for c in cstatuses if c.get("ready"))
                total_c = len(cstatuses)
                ready = f"{ready_count}/{total_c}"
                if phase == "Running":
                    running += 1
                pods.append({
                    "namespace": ns,
                    "name": name,
                    "ready": ready,
                    "status": phase,
                })
            return running, len(items), pods
    except Exception:
        pass
    return 0, 0, []


def fetch_tickets(domain: str, source: Optional[str] = None) -> List[Dict[str, Any]]:
    base_url = f"https://dashboard.{domain}/api/tickets"
    query = f"?source={source}" if source else ""
    ctx = get_ssl_context()
    tickets = []
    page = 1
    total_pages = 1
    while page <= total_pages:
        sep = "&" if query else "?"
        url = f"{base_url}{query}{sep}page={page}"
        req = urllib.request.Request(url, headers={"Accept": "application/json"})
        try:
            with urllib.request.urlopen(req, context=ctx, timeout=5) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                tickets.extend(data.get("tickets", []))
                total_pages = data.get("pages", 1)
                page += 1
        except Exception:
            break
    return tickets


def fetch_runners(domain: str) -> List[Dict[str, str]]:
    url = f"https://github.{domain}/admin/api/runners"
    ctx = get_ssl_context()
    token = os.environ.get("GITHUB_EMULATOR_TOKEN", "ghp_admin_default_token")
    req = urllib.request.Request(
        url,
        headers={"Authorization": f"token {token}", "Accept": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, context=ctx, timeout=5) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            runners = []
            for r in data:
                name = r.get("name", "")
                scope_kind = r.get("scope_kind", "")
                scope_name = r.get("scope_name", "")
                if name == "fullsend-agent-runner":
                    scope = "fullsend-dev/triage-target"
                elif scope_kind == "enterprise":
                    scope = "enterprise"
                elif scope_kind == "repository":
                    scope = scope_name or "repository"
                elif scope_kind == "site":
                    scope = "site"
                else:
                    scope = scope_name or scope_kind or "site"
                status = r.get("status", "online")
                runners.append({
                    "name": name,
                    "scope": scope,
                    "status": status,
                })
            return runners
    except Exception:
        return [
            {
                "name": "fullsend-agent-runner",
                "scope": "fullsend-dev/triage-target",
                "status": "online",
            },
            {
                "name": "breadboard-enterprise-router",
                "scope": "enterprise",
                "status": "online",
            },
        ]


def fetch_runs(
    domain: str, repo: str, limit: int = 20
) -> Tuple[int, List[Dict[str, Any]]]:
    ctx = get_ssl_context()
    token = os.environ.get("GITHUB_EMULATOR_TOKEN", "ghp_admin_default_token")
    url = f"https://github.{domain}/api/v3/repos/{repo}/actions/runs?per_page={max(limit, 30)}"
    req = urllib.request.Request(
        url,
        headers={"Authorization": f"token {token}", "Accept": "application/json"},
    )
    with urllib.request.urlopen(req, context=ctx, timeout=6) as resp:
        data = json.loads(resp.read().decode("utf-8"))
        total = data.get("total_count", 0)
        runs = []
        for r in data.get("workflow_runs", []):
            runs.append({
                "id": r.get("id"),
                "repo": repo,
                "event": r.get("event"),
                "status": r.get("status"),
                "conclusion": r.get("conclusion") or "active",
                "created_at": r.get("created_at"),
            })
        return total, runs


def fetch_jobs(domain: str, repo: str, run_id: int) -> List[Dict[str, Any]]:
    ctx = get_ssl_context()
    token = os.environ.get("GITHUB_EMULATOR_TOKEN", "ghp_admin_default_token")
    url = f"https://github.{domain}/api/v3/repos/{repo}/actions/runs/{run_id}/jobs?per_page=100"
    req = urllib.request.Request(
        url,
        headers={"Authorization": f"token {token}", "Accept": "application/json"},
    )
    with urllib.request.urlopen(req, context=ctx, timeout=6) as resp:
        data = json.loads(resp.read().decode("utf-8"))
        jobs = []
        for j in data.get("jobs", []):
            jobs.append({
                "id": j.get("id"),
                "name": j.get("name"),
                "status": j.get("status"),
                "conclusion": j.get("conclusion") or "-",
                "runner": j.get("runner_name") or "-",
            })
        return jobs


def fetch_job_log(domain: str, repo: str, job_id: int) -> str:
    ctx = get_ssl_context()
    token = os.environ.get("GITHUB_EMULATOR_TOKEN", "ghp_admin_default_token")
    url = f"https://github.{domain}/api/v3/repos/{repo}/actions/jobs/{job_id}/logs"
    req = urllib.request.Request(
        url,
        headers={"Authorization": f"token {token}"},
    )
    with urllib.request.urlopen(req, context=ctx, timeout=8) as resp:
        return resp.read().decode("utf-8", errors="replace")


def runner_openshell_cmd(args: List[str]) -> Tuple[int, str]:
    cmd = [
        "kubectl",
        "-n",
        "ai-pipeline",
        "exec",
        "deploy/github-actions-runner",
        "--",
        "openshell",
    ] + args
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        return proc.returncode, proc.stdout
    except Exception as exc:
        return 1, str(exc)


# --- Subcommand Implementations ---


def cmd_home(domain: str) -> None:
    bin_path = os.path.abspath(__file__)
    home = os.path.expanduser("~")
    if bin_path.startswith(home):
        bin_path = "~" + bin_path[len(home) :]

    print(f"bin: {bin_path}")
    print("description: Breadboard K3s cluster, emulator, and Fullsend operations CLI")

    # Cluster status
    max_temp, _ = get_thermal()
    pods_running, pods_total, _ = get_workloads()
    print("cluster{host,domain,max_temp_c,pods_running,pods_total}:")
    print(f"  rhea,{domain},{max_temp},{pods_running},{pods_total}")

    # Tickets summary
    tickets = fetch_tickets(domain)
    total_tickets = len(tickets)
    gh_t = sum(1 for t in tickets if t.get("source") == "github")
    gl_t = sum(1 for t in tickets if t.get("source") == "gitlab")
    jira_t = sum(1 for t in tickets if t.get("source") == "jira")
    print("tickets{total,github,gitlab,jira}:")
    print(f"  {total_tickets},{gh_t},{gl_t},{jira_t}")

    # Runners
    runners = fetch_runners(domain)
    print(f"runners[{len(runners)}]{{name,scope,status}}:")
    for r in runners:
        print(f"  {r['name']},{r['scope']},{r['status']}")

    # Recent runs (top 5 across triage and cve targets)
    all_runs = []
    for r_repo in ("fullsend-dev/triage-target", "fullsend-dev/cve-target"):
        try:
            _, r_list = fetch_runs(domain, r_repo, limit=5)
            all_runs.extend(r_list)
        except Exception:
            pass
    all_runs.sort(key=lambda item: item.get("id") or 0, reverse=True)
    recent = all_runs[:5]
    print(f"recent_runs[{len(recent)}]{{id,repo,event,status,conclusion}}:")
    for r in recent:
        print(f"  {r['id']},{r['repo']},{r['event']},{r['status']},{r['conclusion']}")

    # Contextual help (AXI 9 & 10)
    print("help[4]:")
    print(
        "  Run `./scripts/bb logs <run_id>` to inspect a workflow run and its failed or triage job log"
    )
    print(
        "  Run `./scripts/bb runs --repo fullsend-dev/cve-target` to list runs for a repository"
    )
    print("  Run `./scripts/bb status` for full K3s, OpenShell, and thermal details")
    print(
        "  Run `./scripts/bb --skill` to load the full Breadboard operations & patch-layer guide"
    )


def cmd_status(domain: str) -> None:
    max_temp, t_status = get_thermal()
    print("thermal{host,max_temp_c,status}:")
    print(f"  rhea,{max_temp},{t_status}")

    _, _, pods = get_workloads()
    print(f"workloads[{len(pods)}]{{namespace,name,ready,status}}:")
    for p in pods:
        print(f"  {p['namespace']},{p['name']},{p['ready']},{p['status']}")

    # OpenShell profiles
    rc, p_out = runner_openshell_cmd(["provider", "profile", "list", "-o", "json"])
    profiles = []
    if rc == 0:
        try:
            profiles = json.loads(p_out)
        except Exception:
            pass
    print(f"openshell_profiles[{len(profiles)}]{{id,display_name,category}}:")
    for prof in profiles:
        print(
            f"  {toon_val(prof.get('id'))},{toon_val(prof.get('display_name'))},{toon_val(prof.get('category'))}"
        )

    # OpenShell providers
    rc, prov_out = runner_openshell_cmd(["provider", "list", "-o", "json"])
    providers = []
    if rc == 0:
        try:
            prov_data = json.loads(prov_out)
            providers = prov_data.get("providers", [])
        except Exception:
            pass
    print(f"openshell_providers[{len(providers)}]{{id,name,type}}:")
    for prov in providers:
        print(
            f"  {toon_val(prov.get('id'))},{toon_val(prov.get('name'))},{toon_val(prov.get('type'))}"
        )

    # OpenShell sandboxes (definitive empty state per AXI 5)
    rc, s_out = runner_openshell_cmd(["sandbox", "list", "-o", "json"])
    sandboxes = []
    if rc == 0:
        try:
            s_data = json.loads(s_out)
            sandboxes = s_data.get("sandboxes", [])
        except Exception:
            pass
    print("openshell_sandboxes:")
    if not sandboxes:
        print("  sandboxes: 0 active sandboxes in openshell-system")
    else:
        print(f"  sandboxes[{len(sandboxes)}]{{id,status,created_at}}:")
        for sb in sandboxes:
            print(
                f"    {toon_val(sb.get('id'))},{toon_val(sb.get('status'))},{toon_val(sb.get('created_at'))}"
            )

    # Tickets
    tickets = fetch_tickets(domain)
    total_tickets = len(tickets)
    gh_t = sum(1 for t in tickets if t.get("source") == "github")
    gl_t = sum(1 for t in tickets if t.get("source") == "gitlab")
    jira_t = sum(1 for t in tickets if t.get("source") == "jira")
    print("tickets{total,github,gitlab,jira}:")
    print(f"  {total_tickets},{gh_t},{gl_t},{jira_t}")


def cmd_runs(domain: str, repo_arg: str, limit_arg: str) -> None:
    try:
        limit = int(limit_arg)
    except ValueError:
        limit = 10

    if repo_arg == "all":
        runs = []
        total = 0
        for r_repo in ("fullsend-dev/triage-target", "fullsend-dev/cve-target"):
            try:
                sub_total, sub_runs = fetch_runs(domain, r_repo, limit=limit)
                total += sub_total
                runs.extend(sub_runs)
            except Exception as e:
                error_exit("runtime", f"failed to fetch runs for {r_repo}: {e}", "check emulator status")
        runs.sort(key=lambda item: item.get("id") or 0, reverse=True)
    else:
        target_repo = repo_arg or "fullsend-dev/triage-target"
        try:
            total, runs = fetch_runs(domain, target_repo, limit=limit)
        except Exception as e:
            error_exit("runtime", f"failed to fetch runs for {target_repo}: {e}", "check emulator status")

    displayed = runs[:limit]
    if not displayed:
        print(f"runs: 0 workflow runs found for {repo_arg}")
        return

    print(f"count: {len(displayed)} of {total} total")
    print(f"runs[{len(displayed)}]{{id,repo,event,status,conclusion,created_at}}:")
    for r in displayed:
        print(
            f"  {r['id']},{r['repo']},{r['event']},{r['status']},{r['conclusion']},{r['created_at']}"
        )


def cmd_logs(
    domain: str, run_id_str: str, repo_arg: str, job_filter: Optional[str], full: bool
) -> None:
    try:
        run_id = int(run_id_str)
    except ValueError:
        error_exit(
            "usage",
            f"invalid run_id `{run_id_str}` for `logs`",
            "run_id must be an integer, e.g. ./scripts/bb logs 50",
            exit_code=2,
        )

    target_repo = repo_arg or "fullsend-dev/triage-target"
    jobs = []
    try:
        jobs = fetch_jobs(domain, target_repo, run_id)
    except urllib.error.HTTPError as err:
        if err.code == 404 and not repo_arg:
            target_repo = "fullsend-dev/cve-target"
            try:
                jobs = fetch_jobs(domain, target_repo, run_id)
            except Exception as e:
                error_exit(
                    "runtime",
                    f"failed to fetch jobs for run {run_id}: {e}",
                    "verify run_id with ./scripts/bb runs --repo all",
                )
        else:
            error_exit(
                "runtime",
                f"failed to fetch jobs for run {run_id}: {err}",
                "verify run_id with ./scripts/bb runs",
            )
    except Exception as e:
        error_exit(
            "runtime",
            f"failed to fetch jobs for run {run_id}: {e}",
            "verify emulator is reachable",
        )

    if not jobs:
        print(f"jobs: 0 jobs found for workflow run {run_id}")
        return

    print(f"jobs[{len(jobs)}]{{id,name,status,conclusion,runner}}:")
    for j in jobs:
        print(f"  {j['id']},{j['name']},{j['status']},{j['conclusion']},{j['runner']}")

    # Automatically select job:
    selected_job = None
    if job_filter:
        for j in jobs:
            if job_filter.lower() in j["name"].lower():
                selected_job = j
                break
        if not selected_job:
            avail = ", ".join(j["name"] for j in jobs)
            error_exit(
                "usage",
                f"no job matching `{job_filter}` found in run {run_id}",
                f"available jobs: {avail}",
                exit_code=2,
            )
    else:
        # First failed job
        for j in jobs:
            if j["conclusion"] == "failure":
                selected_job = j
                break
        # Else Triage
        if not selected_job:
            for j in jobs:
                if j["name"].lower() == "triage":
                    selected_job = j
                    break
        # Else first job
        if not selected_job:
            selected_job = jobs[0]

    job_id = selected_job["id"]
    try:
        raw_log = fetch_job_log(domain, target_repo, job_id)
    except Exception as e:
        error_exit(
            "runtime",
            f"failed to fetch log for job {job_id}: {e}",
            f"check job with https://github.{domain}/ui/{target_repo}/actions/jobs/{job_id}",
        )

    print("log{job,id}:")
    print(f"  {selected_job['name']},{job_id}")

    total_chars = len(raw_log)
    if total_chars > 1500 and not full:
        print(f"... (truncated, {total_chars} chars total)")
        print(raw_log[-1500:])
        print("help[1]:")
        print(
            f"  Run ./scripts/bb logs {run_id} --repo {target_repo} --full to see complete log"
        )
    else:
        print(raw_log)


def cmd_tickets(domain: str, source: Optional[str], limit_arg: str) -> None:
    try:
        limit = int(limit_arg)
    except ValueError:
        limit = 20

    tickets = fetch_tickets(domain, source=source)
    total = len(tickets)
    if total == 0:
        print(f"tickets: 0 tickets found" + (f" for source {source}" if source else ""))
        return

    displayed = tickets[:limit]
    print(f"count: {len(displayed)} of {total} total")
    print(f"tickets[{len(displayed)}]{{id,source,type,status,title}}:")
    for t in displayed:
        t_id = t.get("id") or t.get("key") or ""
        t_src = t.get("source") or ""
        t_type = t.get("type") or ""
        t_status = t.get("status") or t.get("state") or ""
        t_title = t.get("title") or ""
        print(
            f"  {toon_val(t_id)},{toon_val(t_src)},{toon_val(t_type)},{toon_val(t_status)},{toon_val(t_title)}"
        )


def cmd_openshell(domain: str, action: str) -> None:
    if action == "status":
        # Gateway pod status
        proc = subprocess.run(
            [
                "kubectl",
                "-n",
                "openshell-system",
                "get",
                "pod",
                "-l",
                "app.kubernetes.io/name=openshell",
                "-o",
                "json",
            ],
            capture_output=True,
            text=True,
            timeout=5,
        )
        gw_pod = "openshell-0"
        gw_status = "Unknown"
        if proc.returncode == 0:
            try:
                items = json.loads(proc.stdout).get("items", [])
                if items:
                    gw_pod = items[0]["metadata"].get("name", "openshell-0")
                    gw_status = items[0].get("status", {}).get("phase", "Running")
            except Exception:
                pass
        print("gateway{pod,status,version}:")
        print(f"  {gw_pod},{gw_status},0.1.4")

        # Profiles
        rc, p_out = runner_openshell_cmd(["provider", "profile", "list", "-o", "json"])
        profiles = []
        if rc == 0:
            try:
                profiles = json.loads(p_out)
            except Exception:
                pass
        print(f"openshell_profiles[{len(profiles)}]{{id,display_name,category}}:")
        for prof in profiles:
            print(
                f"  {toon_val(prof.get('id'))},{toon_val(prof.get('display_name'))},{toon_val(prof.get('category'))}"
            )

        # Providers
        rc, prov_out = runner_openshell_cmd(["provider", "list", "-o", "json"])
        providers = []
        if rc == 0:
            try:
                prov_data = json.loads(prov_out)
                providers = prov_data.get("providers", [])
            except Exception:
                pass
        print(f"openshell_providers[{len(providers)}]{{id,name,type}}:")
        for prov in providers:
            print(
                f"  {toon_val(prov.get('id'))},{toon_val(prov.get('name'))},{toon_val(prov.get('type'))}"
            )

        # Sandboxes
        rc, s_out = runner_openshell_cmd(["sandbox", "list", "-o", "json"])
        sandboxes = []
        if rc == 0:
            try:
                s_data = json.loads(s_out)
                sandboxes = s_data.get("sandboxes", [])
            except Exception:
                pass
        print("openshell_sandboxes:")
        if not sandboxes:
            print("  sandboxes: 0 active sandboxes in openshell-system")
        else:
            print(f"  sandboxes[{len(sandboxes)}]{{id,status,created_at}}:")
            for sb in sandboxes:
                print(
                    f"    {toon_val(sb.get('id'))},{toon_val(sb.get('status'))},{toon_val(sb.get('created_at'))}"
                )
    elif action == "reset":
        # Scale to 0
        subprocess.run(
            ["kubectl", "-n", "openshell-system", "scale", "sts/openshell", "--replicas=0"],
            check=True,
            capture_output=True,
        )
        # Delete PVC
        subprocess.run(
            [
                "kubectl",
                "-n",
                "openshell-system",
                "delete",
                "pvc",
                "openshell-data-openshell-0",
                "--wait=false",
            ],
            capture_output=True,
        )
        # Scale back to 1
        subprocess.run(
            ["kubectl", "-n", "openshell-system", "scale", "sts/openshell", "--replicas=1"],
            check=True,
            capture_output=True,
        )
        print("openshell_reset{status,target}:")
        print("  success,sts/openshell")
        print("help[1]:")
        print("  Run `./scripts/bb openshell status` to verify gateway pod readiness")
    else:
        error_exit(
            "usage",
            f"unknown action `{action}` for `openshell`",
            "valid actions: status, reset",
            exit_code=2,
        )


def cmd_seed(domain: str, target: str) -> None:
    project_root = Path(__file__).resolve().parent.parent
    if target == "demo":
        script = project_root / "scripts" / "seed_demo_tickets.py"
        cmd = [sys.executable, str(script)]
    elif target == "cve":
        script = project_root / "deploy" / "fullsend" / "seed" / "seed-cve-fixture.py"
        cmd = [sys.executable, str(script)]
    elif target == "conformance":
        script = project_root / "deploy" / "scripts" / "24-run-conformance-triage.sh"
        cmd = ["bash", str(script), "--keep-issue"]
    else:
        error_exit(
            "usage",
            f"unknown seed target `{target}` for `seed`",
            "valid seed targets: demo, cve, conformance",
            exit_code=2,
        )
    env = dict(os.environ)
    env["BREADBOARD_DOMAIN"] = domain
    proc = subprocess.run(cmd, env=env)
    sys.exit(proc.returncode)


# --- Help texts ---


