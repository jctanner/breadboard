-  REPO=$(echo "${PR_URL}" | sed 's|https://github.com/||; s|/pull/.*||')
+  local rest
+  rest="$(_github_strip_base "${PR_URL}")" || return 1
+  REPO="${rest%%/pull/*}"
   PR_NUMBER=$(basename "${PR_URL}")
 }
 
