diff --git a/internal/cli/tokenscope.go b/internal/cli/tokenscope.go
index 323adfac..8987fc2b 100644
--- a/internal/cli/tokenscope.go
+++ b/internal/cli/tokenscope.go
@@ -4,6 +4,8 @@ import (
 	"context"
 	"fmt"
 	"net/http"
+	"os"
+	"strings"
 	"time"
 
 	gh "github.com/fullsend-ai/fullsend/internal/forge/github"
@@ -11,6 +13,19 @@ import (
 
 var tokenScopeClient = &http.Client{Timeout: 10 * time.Second}
 
+// tokenScopeBaseURL is the REST base the scope check introspects the token
+// against: GITHUB_API_URL when the workflow sets it, as it does on an
+// enterprise install or an emulator, and api.github.com otherwise. The
+// check used to name api.github.com outright, so on any other host it
+// dialled a server the token was never minted for and logged a warning on
+// every run.
+func tokenScopeBaseURL() string {
+	if base := strings.TrimSpace(os.Getenv("GITHUB_API_URL")); base != "" {
+		return strings.TrimRight(base, "/")
+	}
+	return "https://api.github.com"
+}
+
