+func TestReadonlyRepoCommand_NonRootExecUser(t *testing.T) {
+	// OpenShell's Kubernetes driver runs the sandbox as a non-root UID with
+	// every capability dropped. The command must still succeed there: the
+	// chown is for root-owned extractions, and a non-root exec user already
+	// owns the tree.
+	if os.Geteuid() == 0 {
+		t.Skip("exercises the non-root path; running as root")
+	}
+	if _, err := exec.LookPath("sh"); err != nil {
+		t.Skip("sh not available")
+	}
+	repo := filepath.Join(t.TempDir(), "target-repo")
+	require.NoError(t, os.MkdirAll(filepath.Join(repo, ".git", "hooks"), 0o755))
+	require.NoError(t, os.MkdirAll(filepath.Join(repo, "src"), 0o755))
+	require.NoError(t, os.WriteFile(filepath.Join(repo, "src", "main.go"), []byte("package main"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(repo, ".git", "HEAD"), []byte("ref: refs/heads/main"), 0o644))
+	t.Cleanup(func() { _ = forceRemoveAll(repo) })
+
+	out, err := exec.Command("sh", "-c", readonlyRepoCommand(repo)).CombinedOutput()
+	require.NoError(t, err, "readonly command failed: %s", out)
+
+	info, err := os.Stat(filepath.Join(repo, "src", "main.go"))
+	require.NoError(t, err)
+	assert.Zero(t, info.Mode().Perm()&0o222, "working-tree file should be read-only")
+	info, err = os.Stat(filepath.Join(repo, ".git", "HEAD"))
+	require.NoError(t, err)
+	assert.NotZero(t, info.Mode().Perm()&0o200, ".git should stay writable")
+}
+
+func TestReadonlyRepoCommand_ChownsOnlyAsRoot(t *testing.T) {
+	cmd := readonlyRepoCommand("/sandbox/workspace/target-repo")
+	assert.Contains(t, cmd, `{ [ "$(id -u)" != 0 ] || chown -R sandbox:sandbox /sandbox/workspace/target-repo/.git; }`)
+	assert.True(t, strings.HasSuffix(cmd, "chmod -R u+w /sandbox/workspace/target-repo/.git"))
+}
