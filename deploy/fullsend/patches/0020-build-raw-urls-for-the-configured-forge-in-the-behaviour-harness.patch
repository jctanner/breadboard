@@ -0,0 +1,21 @@
+package steps
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestRawContentURL_GitHubCom(t *testing.T) {
+	for _, server := range []string{"", "https://github.com", "https://github.com/"} {
+		t.Setenv("GITHUB_SERVER_URL", server)
+		assert.Equal(t, "https://raw.githubusercontent.com/o/r/main/a/b.yaml", rawContentURL("o", "r", "main", "a/b.yaml"))
+		assert.Equal(t, "https://raw.githubusercontent.com/o/r/", rawContentPrefix("o", "r"))
+	}
+}
+
+func TestRawContentURL_ConfiguredForge(t *testing.T) {
+	t.Setenv("GITHUB_SERVER_URL", "https://github.example/")
+	assert.Equal(t, "https://github.example/o/r/raw/main/a/b.yaml", rawContentURL("o", "r", "main", "a/b.yaml"))
+	assert.Equal(t, "https://github.example/o/r/", rawContentPrefix("o", "r"))
+}
