#!/usr/bin/env bash
set -euo pipefail

staged=false
files=()
for arg in "$@"; do
  case "${arg}" in
    --staged) staged=true ;;
    *) files+=("${arg}") ;;
  esac
done

if [[ "${staged}" == true ]]; then
  mapfile -t files < <(git diff --cached --name-only)
elif [[ ${#files[@]} -gt 0 ]]; then
  git add -- "${files[@]}"
fi

if [[ ${#files[@]} -eq 0 ]]; then
  echo "usage: scan-secrets [--staged | file1 file2 ...]" >&2
  exit 1
fi

status=0
gitleaks protect --no-banner --staged --verbose || status=$?

if [[ "${staged}" != true ]]; then
  git reset HEAD -- "${files[@]}" >/dev/null 2>&1 || true
fi

if [[ ${status} -ne 0 ]]; then
  echo "error: secret scan failed — do NOT proceed" >&2
  exit "${status}"
fi
printf 'ok: secret scan passed for %d file(s)\n' "${#files[@]}"
