# Minimal breadboard sandbox for the M4 Fullsend/OpenShell smoke.
#
# This starts from the already imported pipeline-agent image and adds the
# minimum dependencies required by the real Fullsend code harness.
FROM pipeline-agent:latest

USER root
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends tar gzip ca-certificates curl jq \
    && rm -rf /var/lib/apt/lists/*

# The upstream triage agent uses gh for all GitHub reads and writes. This
# local image keeps the development sandbox compatible with that harness.
ARG TARGETARCH=amd64
ARG GH_VERSION=2.96.0
ARG GH_SHA256_AMD64=83d5c2ccad5498f58bf6368acb1ab32588cf43ab3a4b1c301bf36328b1c8bd60
ARG GH_SHA256_ARM64=06f86ec7103d41993b76cd78072f43595c34aaa56506d971d9860e67140bf909
RUN case "${TARGETARCH}" in \
      amd64) GH_SHA="${GH_SHA256_AMD64}" ;; \
      arm64) GH_SHA="${GH_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${TARGETARCH}.tar.gz" -o /tmp/gh.tar.gz \
    && echo "${GH_SHA}  /tmp/gh.tar.gz" | sha256sum -c - \
    && tar xzf /tmp/gh.tar.gz -C /tmp \
    && install -m 0755 "/tmp/gh_${GH_VERSION}_linux_${TARGETARCH}/bin/gh" /usr/local/bin/gh \
    && rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_${TARGETARCH}"

# The code-implementation skill treats this helper as a mandatory security
# gate. Keep the scanner version/checksum pinned so a reset reproduces the
# same toolchain and the agent cannot silently substitute another scanner.
ARG GITLEAKS_VERSION=8.30.1
ARG GITLEAKS_SHA256_AMD64=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
ARG GITLEAKS_SHA256_ARM64=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
RUN case "${TARGETARCH}" in \
      amd64) GL_ARCH="x64"; GL_SHA="${GITLEAKS_SHA256_AMD64}" ;; \
      arm64) GL_ARCH="arm64"; GL_SHA="${GITLEAKS_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${GL_ARCH}.tar.gz" -o /tmp/gitleaks.tar.gz \
    && echo "${GL_SHA}  /tmp/gitleaks.tar.gz" | sha256sum -c - \
    && tar xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
    && chmod 0755 /usr/local/bin/gitleaks \
    && rm -f /tmp/gitleaks.tar.gz

# The runner validates agent-result.json with this same pinned version. The
# OpenShell runtime invokes the system /usr/local/bin/python3, so install into
# that interpreter explicitly rather than the pipeline-agent build venv.
RUN /usr/local/bin/uv pip install --system --python /usr/local/bin/python3 "jsonschema==4.23.0"

# Required by the code-implementation skill; it scans named files or the
# staged index using the image-provided gitleaks binary.
COPY scan-secrets /usr/local/bin/scan-secrets
RUN chmod 0755 /usr/local/bin/scan-secrets

# OpenShell injects its proxy CA at runtime. These variables make the same
# CA usable by gh, curl, git, Python, and Node inside the sandbox.
RUN mkdir -p /etc/openshell-tls \
    && ln -sf /etc/ssl/certs/ca-certificates.crt /etc/openshell-tls/ca-bundle.pem
ENV GIT_SSL_CAINFO=/etc/openshell-tls/ca-bundle.pem \
    SSL_CERT_FILE=/etc/openshell-tls/ca-bundle.pem \
    REQUESTS_CA_BUNDLE=/etc/openshell-tls/ca-bundle.pem \
    CURL_CA_BUNDLE=/etc/openshell-tls/ca-bundle.pem \
    NODE_EXTRA_CA_CERTS=/etc/openshell-tls/ca-bundle.pem

ENV BREADBOARD_FULLSEND_SANDBOX=1

USER pipelineagent
