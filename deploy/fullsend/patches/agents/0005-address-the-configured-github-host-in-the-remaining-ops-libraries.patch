@@ -0,0 +1,150 @@
+#!/usr/bin/env bash
+# github-host-validation-test.sh — Test GitHub forge host derivation.
+#
+# The GitHub ops libraries matched and stripped a literal https://github.com,
+# so a GitHub Enterprise host was rejected as a malformed URL. The GitLab side
+# has had a host-mismatch test since CI_SERVER_HOST was introduced; this is its
+# GitHub counterpart, and its absence is why the assumption survived.
+#
+# Run from the repo root:
+#   bash scripts/github-host-validation-test.sh
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=test-lib.sh
+source "${SCRIPT_DIR}/test-lib.sh"
+parse_script_test_args "$@"
+
+FAILURES=0
+
+check() {
+  local name="$1" expected="$2" actual="$3"
+  if [[ "${expected}" == "${actual}" ]]; then
+    echo "PASS: ${name}"
+  else
+    echo "FAIL: ${name}"
+    echo "  expected: ${expected}"
+    echo "  actual:   ${actual}"
+    FAILURES=$((FAILURES + 1))
+  fi
+}
+
+check_fails() {
+  local name="$1"; shift
+  if "$@" >/dev/null 2>&1; then
+    echo "FAIL: ${name} — expected non-zero exit but got 0"
+    FAILURES=$((FAILURES + 1))
+  else
+    echo "PASS: ${name}"
+  fi
+}
+
+# Each case runs in a subshell so one test's GITHUB_SERVER_URL cannot leak into
+# the next, and so the libraries' load guards are re-evaluated each time.
+run_case() {
+  local server_url="$1" body="$2"
+  (
+    if [[ -n "${server_url}" ]]; then
+      export GITHUB_SERVER_URL="${server_url}"
+    else
+      unset GITHUB_SERVER_URL
+    fi
+    # shellcheck source=lib/github-host-validation.lib.sh
+    source "${SCRIPT_DIR}/lib/github-host-validation.lib.sh"
+    # shellcheck source=lib/github-review-ops.lib.sh
+    source "${SCRIPT_DIR}/lib/github-review-ops.lib.sh"
+    # shellcheck source=lib/github-code-ops.lib.sh
+    source "${SCRIPT_DIR}/lib/github-code-ops.lib.sh"
+    eval "${body}"
+  )
+}
+
+# --- No GITHUB_SERVER_URL: behaviour must be exactly what it was -----------
+
+check "default-base-url" "https://github.com" \
+  "$(run_case "" '_github_base_url')"
+
+check "default-accepts-dotcom-pr" "ok" \
+  "$(run_case "" 'PR_URL=https://github.com/o/r/pull/7; forge_validate_pr_url && echo ok')"
+
+check "default-parses-dotcom-pr" "o/r 7" \
+  "$(run_case "" 'PR_URL=https://github.com/o/r/pull/7; forge_parse_pr_url; echo "${REPO} ${PR_NUMBER}"')"
+
+# --- An enterprise host: the case that was rejected outright ---------------
+
+check "enterprise-accepts-pr" "ok" \
+  "$(run_case "https://github.example.org" \
+     'PR_URL=https://github.example.org/o/r/pull/7; forge_validate_pr_url && echo ok')"
+
+check "enterprise-parses-pr" "o/r 7" \
+  "$(run_case "https://github.example.org" \
+     'PR_URL=https://github.example.org/o/r/pull/7; forge_parse_pr_url; echo "${REPO} ${PR_NUMBER}"')"
+
+check "enterprise-parses-issue" "o/r 12" \
+  "$(run_case "https://github.example.org" \
+     'ISSUE_URL=https://github.example.org/o/r/issues/12; forge_parse_issue_url; echo "${REPO_FULL_NAME} ${ISSUE_NUMBER}"')"
+
+check "enterprise-extracts-repo" "o/r" \
+  "$(run_case "https://github.example.org" \
+     'forge_extract_repo_from_url https://github.example.org/o/r/issues/12')"
+
+check "enterprise-host-with-port" "ok" \
+  "$(run_case "https://github.example.org:8443" \
+     'PR_URL=https://github.example.org:8443/o/r/pull/7; forge_validate_pr_url && echo ok')"
+
+# --- Still rejects what it should ------------------------------------------
+
+# github.com is not special once a server URL is configured: a URL on any other
+# host is somebody else's, and accepting it would hand a minted token over.
+check_fails "enterprise-rejects-other-host" \
+  bash -c "GITHUB_SERVER_URL=https://github.example.org; export GITHUB_SERVER_URL
+    source '${SCRIPT_DIR}/lib/github-review-ops.lib.sh'
+    PR_URL=https://github.com/o/r/pull/7
+    forge_validate_pr_url"
+
+# The host is stripped as a literal prefix and never interpolated into a
+# regular expression, so a lookalike host does not match: the strip is a no-op,
+# the remainder still carries a scheme, and validation fails. Matching a host
+# built into a pattern would let a dot stand for any character.
+check_fails "lookalike-host-is-not-accepted" \
+  bash -c "GITHUB_SERVER_URL=https://github.example.org; export GITHUB_SERVER_URL
+    source '${SCRIPT_DIR}/lib/github-review-ops.lib.sh'
+    PR_URL=https://githubXexample.org/o/r/pull/7
+    forge_validate_pr_url"
+
+# A server URL carrying a path would be spliced into URL matching and stripping.
+check_fails "rejects-server-url-with-path" \
+  bash -c "GITHUB_SERVER_URL=https://github.example.org/prefix; export GITHUB_SERVER_URL
+    source '${SCRIPT_DIR}/lib/github-host-validation.lib.sh'
+    _github_base_url"
+
+check_fails "rejects-non-https-server-url" \
+  bash -c "GITHUB_SERVER_URL=http://github.example.org; export GITHUB_SERVER_URL
+    source '${SCRIPT_DIR}/lib/github-host-validation.lib.sh'
+    _github_base_url"
+
+# --- The push remote ------------------------------------------------------
+
+# The token belongs in the authority, so the scheme comes off the base URL
+# first. Splicing the whole base in would yield
+# https://x-access-token:TOKEN@https://host/... and push nowhere.
+check "push-remote-targets-the-configured-host" \
+  "https://x-access-token:TOK@github.example.org/o/r.git" \
+  "$(run_case "https://github.example.org" \
+     'REPO_FULL_NAME=o/r
+      git() { [[ "$1 $2" == "remote set-url" ]] && printf "%s" "$4"; }
+      forge_set_push_remote TOK')"
+
+check "push-remote-default-is-dotcom" \
+  "https://x-access-token:TOK@github.com/o/r.git" \
+  "$(run_case "" \
+     'REPO_FULL_NAME=o/r
+      git() { [[ "$1 $2" == "remote set-url" ]] && printf "%s" "$4"; }
+      forge_set_push_remote TOK')"
+
+if [[ ${FAILURES} -gt 0 ]]; then
+  echo "${FAILURES} test(s) failed"
+  exit 1
+fi
+echo "All github host validation tests passed"
