@@ -135,8 +147,56 @@
 
 // DefaultPolicy is a sensible default policy allowing GitHub content hosts
 // and the configured forge.
+// allowPrivateForgeEnv opts the configured forge host out of internal-IP
+// validation. It is deliberately explicit and deliberately narrow: it names no
+// host itself, so it can only ever exempt the forge GITHUB_SERVER_URL already
+// points at, and only when an operator has set it.
+const allowPrivateForgeEnv = "FULLSEND_ALLOW_PRIVATE_FORGE"
+
+// configuredForgeHost returns the hostname of GITHUB_SERVER_URL, or "".
+func configuredForgeHost() string {
+	server := strings.TrimSpace(os.Getenv("GITHUB_SERVER_URL"))
+	if server == "" {
+		return ""
+	}
+	parsed, err := url.Parse(server)
+	if err != nil {
+		return ""
+	}
+	return strings.ToLower(parsed.Hostname())
+}
+
+// defaultPrivateHosts returns the hosts exempt from internal-IP validation.
+//
+// Empty unless an operator opted in, and even then it holds at most the forge
+// host. github.com is never included: it has public addresses, so exempting it
+// would only ever help an attacker who could make it resolve privately.
+func defaultPrivateHosts() []string {
+	if strings.TrimSpace(os.Getenv(allowPrivateForgeEnv)) != "1" {
+		return nil
+	}
+	host := configuredForgeHost()
+	if host == "" || host == "github.com" || strings.HasSuffix(host, ".github.com") {
+		return nil
+	}
+	return []string{host}
+}
+
+// hostAllowsPrivate reports whether this exact host was exempted. Matching is
+// exact: no wildcards, because a wildcard exemption is how one narrow
+// allowance becomes a broad one.
+func hostAllowsPrivate(hostname string, privateHosts []string) bool {
+	for _, candidate := range privateHosts {
+		if strings.EqualFold(strings.TrimSpace(candidate), hostname) {
+			return true
+		}
+	}
+	return false
+}
+
 var DefaultPolicy = FetchPolicy{
 	AllowedDomains: defaultAllowedDomains(),
+	PrivateHosts:   defaultPrivateHosts(),
 	MaxSizeBytes:   10 * 1024 * 1024, // 10 MB
 	Timeout:        30 * time.Second,
 	// MaxRetries: nil → uses default (4 total attempts).
@@ -204,7 +264,7 @@
