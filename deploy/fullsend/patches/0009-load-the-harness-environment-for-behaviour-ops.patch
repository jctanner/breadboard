+// Behaviour operations run in a fresh shell per call, so a value delivered
+// through the harness environment file is invisible unless the operation
+// sources it. This is what made assert_env report a correctly delivered
+// GH_HOST as unset.
+func TestExecuteBehaviourOpLoadsHarnessEnv(t *testing.T) {
+	t.Parallel()
+
+	ops := []BehaviourOperation{
+		{Op: "assert_env", Args: "GH_HOST"},
+		{Op: "assert_file", Args: "README.md"},
+		{Op: "assert_json", Args: "output/agent-result.json,action"},
+		{Op: "read_file", Args: "README.md"},
+		{Op: "checkout_branch", Args: "agent/42-fix-widget"},
+		{Op: "url_get", Args: "http://example.invalid/probe"},
+	}
+	for _, op := range ops {
+		t.Run(op.Op, func(t *testing.T) {
+			var got string
+			rt := DummyRuntime{
+				ExecFn: func(_, cmd string, _ time.Duration) (string, string, int, error) {
+					got = cmd
+					return "", "", 0, nil
+				},
+				// checkout_branch probes the remote on the runner first;
+				// report the branch absent so only the sandbox command runs.
+				HostGitFn: func(context.Context, string, ...string) (string, string, int, error) {
+					return "", "", 2, nil
+				},
+				hostRepoDir: "/host/repo",
+			}
+			require.NoError(t, executeBehaviourOp(rt, "sb", sandbox.SandboxWorkspace+"/target-repo", op))
+			assert.Contains(t, got, ". '"+sandbox.SandboxWorkspace+"/.env'",
+				"%s must source the harness environment", op.Op)
+		})
+	}
+}
+
 func TestExecuteHTTPProbe_ExecError(t *testing.T) {
 	t.Parallel()
 
@@ -1606,3 +1649,28 @@ func TestExecuteBehaviourOp_AssertNotJWT(t *testing.T) {
 	err = executeBehaviourOp(rt, "sandbox", t.TempDir(), BehaviourOperation{Op: "assert_not_jwt", Args: "X"})
 	require.ErrorContains(t, err, "exec down")
 }
+
+// A scenario whose harness environment is missing is not testing what it
+// claims to, so the operation says that rather than reporting the assertion
+// itself as the failure.
+func TestExecuteBehaviourOpReportsMissingHarnessEnv(t *testing.T) {
+	t.Parallel()
+
+	rt := DummyRuntime{
+		ExecFn: func(_, cmd string, _ time.Duration) (string, string, int, error) {
+			// Stand in for a sandbox with no environment file: run the
+			// generated command and let its own guard decide.
+			out, err := exec.Command("sh", "-c", cmd).CombinedOutput()
+			code := 0
+			var ee *exec.ExitError
+			if errors.As(err, &ee) {
+				code = ee.ExitCode()
+			}
+			return "", string(out), code, nil
+		},
+	}
+	err := executeBehaviourOp(rt, "sb", sandbox.SandboxWorkspace+"/target-repo",
+		BehaviourOperation{Op: "assert_env", Args: "GH_HOST"})
+	require.Error(t, err)
+	assert.Contains(t, err.Error(), "harness environment file not readable")
+}
