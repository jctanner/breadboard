+// configuredForgeHost returns the hostname of GITHUB_SERVER_URL, or "".
+//
+// GITHUB_SERVER_URL is the standard Actions variable naming the host a run is
+// executing against, and the CLI already reads it elsewhere to decide where
+// the forge is. Reading it here keeps raw-URL parsing consistent with that
+// choice instead of recognising only the public host.
+func configuredForgeHost() string {
+	server := strings.TrimSpace(os.Getenv("GITHUB_SERVER_URL"))
+	if server == "" {
+		return ""
+	}
+	parsed, err := url.Parse(server)
+	if err != nil {
+		return ""
+	}
+	return strings.ToLower(parsed.Hostname())
+}
