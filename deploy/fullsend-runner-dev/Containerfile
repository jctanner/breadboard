# Host-side Fullsend launcher for the local OpenShell development stack.
# The binary creates and manages the sandbox; it is not the sandbox image.
FROM github-emulator-actions-runner:k3s

USER root
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends openssh-client ca-certificates curl tar \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --break-system-packages "jsonschema==4.23.0"

# Fullsend's upstream triage pre/post scripts use the GitHub CLI. Keep this
# pinned and shared with the Fullsend runner image rather than relying on the
# base GitHub emulator image to happen to contain it.
ARG TARGETARCH=amd64
ARG GH_VERSION=2.96.0
ARG GH_SHA256_AMD64=83d5c2ccad5498f58bf6368acb1ab32588cf43ab3a4b1c301bf36328b1c8bd60
ARG GH_SHA256_ARM64=06f86ec7103d41993b76cd78072f43595c34aaa56506d971d9860e67140bf909
RUN case "${TARGETARCH}" in \
      amd64) GH_SHA="${GH_SHA256_AMD64}" ;; \
      arm64) GH_SHA="${GH_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${TARGETARCH}.tar.gz" -o /tmp/gh.tar.gz \
    && echo "${GH_SHA}  /tmp/gh.tar.gz" | sha256sum -c - \
    && tar xzf /tmp/gh.tar.gz -C /tmp \
    && install -m 0755 "/tmp/gh_${GH_VERSION}_linux_${TARGETARCH}/bin/gh" /usr/local/bin/gh \
    && rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_${TARGETARCH}"

# Fullsend's dispatch workflow reads its config with yq in ten places (kill
# switch, agent enablement, role gating). Without it those steps fail with
# "yq: command not found" after routing has already succeeded.
ARG YQ_VERSION=4.53.6
ARG YQ_SHA256_AMD64=c5f056448f973ae7d39b5401949648a78f2dc1947d6a8eb65be60d5c504b9385
ARG YQ_SHA256_ARM64=88a1016bc1d657375a35864e4f44b6f333df8ff97b559f51bba0adcb2169df09
RUN case "${TARGETARCH}" in \
      amd64) YQ_SHA="${YQ_SHA256_AMD64}" ;; \
      arm64) YQ_SHA="${YQ_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/yq_linux_${TARGETARCH}" -o /tmp/yq \
    && echo "${YQ_SHA}  /tmp/yq" | sha256sum -c - \
    && install -m 0755 /tmp/yq /usr/local/bin/yq \
    && rm -f /tmp/yq

# post-code.sh and post-fix.sh scan the agent's commits for secrets before
# pushing, and gate on pre-commit. Both install themselves at run time -
# gitleaks from GitHub releases, pre-commit from PyPI - which works only
# because the runner pod can reach the public internet. That egress is F4 in
# the conformance plan and is meant to close; when it does, a self-installing
# tool becomes a job that fails at the secret scan, after the agent has
# already done its work.
#
# So both are shipped here, pinned to exactly the versions those scripts would
# have fetched (gitleaks 8.30.1, pre-commit 4.5.1). The scripts find them on
# PATH and skip their download, so this is the same binary by a different
# route rather than a divergence - and their install paths stay as a fallback.
# Keep these versions in step with scripts/lib/gitleaks-install.lib.sh and
# scripts/lib/precommit-gate.lib.sh in fullsend-ai/agents.
ARG GITLEAKS_VERSION=8.30.1
ARG GITLEAKS_SHA256_AMD64=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
ARG GITLEAKS_SHA256_ARM64=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
RUN case "${TARGETARCH}" in \
      amd64) GITLEAKS_SHA="${GITLEAKS_SHA256_AMD64}"; GITLEAKS_PLATFORM=linux_x64 ;; \
      arm64) GITLEAKS_SHA="${GITLEAKS_SHA256_ARM64}"; GITLEAKS_PLATFORM=linux_arm64 ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_${GITLEAKS_PLATFORM}.tar.gz" -o /tmp/gitleaks.tar.gz \
    && echo "${GITLEAKS_SHA}  /tmp/gitleaks.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/gitleaks.tar.gz -C /tmp gitleaks \
    && install -m 0755 /tmp/gitleaks /usr/local/bin/gitleaks \
    && rm -f /tmp/gitleaks.tar.gz /tmp/gitleaks \
    && gitleaks version

ARG PRECOMMIT_VERSION=4.5.1
RUN python3 -m pip install --no-cache-dir --break-system-packages \
      "pre-commit==${PRECOMMIT_VERSION}" \
    && pre-commit --version

# Fullsend's agent action installs a Go toolchain when it builds the CLI from
# source, which is the path a local stack takes because the emulator carries no
# releases. Ship the toolchain its go.mod asks for rather than downloading one
# per job: the runner's setup-go emulation uses this when it satisfies the
# requested version, and Go's own toolchain switching covers a newer request,
# so the download path stays a fallback rather than the norm.
ARG GO_VERSION=1.26.5
ARG GO_SHA256_AMD64=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053
ARG GO_SHA256_ARM64=fe4789e92b1f33358680864bbe8704289e7bb5fc207d80623c308935bd696d49
RUN case "${TARGETARCH}" in \
      amd64) GO_SHA="${GO_SHA256_AMD64}" ;; \
      arm64) GO_SHA="${GO_SHA256_ARM64}" ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz" -o /tmp/go.tar.gz \
    && echo "${GO_SHA}  /tmp/go.tar.gz" | sha256sum -c - \
    && rm -rf /usr/local/go \
    && tar xzf /tmp/go.tar.gz -C /usr/local \
    && rm -f /tmp/go.tar.gz \
    && /usr/local/go/bin/go version

COPY fullsend /usr/local/bin/fullsend
COPY openshell /usr/local/bin/openshell
# Fullsend's long-lived runner deployments use this image directly. Keep the
# Actions runner implementation synchronized with the checked-out emulator;
# otherwise rebuilding only the emulator image leaves the Fullsend runners
# executing an older embedded runner.
COPY runner.py /app/runner.py
RUN chmod 0755 /usr/local/bin/fullsend /usr/local/bin/openshell

ENV PATH="/usr/local/bin:${PATH}"
ENV PYTHONPATH=""
