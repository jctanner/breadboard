diff --git a/scripts/post-prioritize.sh b/scripts/post-prioritize.sh
index 82b56624..51b0784f 100755
--- a/scripts/post-prioritize.sh
+++ b/scripts/post-prioritize.sh
@@ -378,18 +378,83 @@ github_csma_run_cmd() {
   return 1
 }
 # END bundled: lib/github-api-csma.lib.sh
+# shellcheck source=github-host-validation.lib.sh
+# BEGIN bundled: lib/github-host-validation.lib.sh
+# shellcheck shell=bash
+# github-host-validation.lib.sh — Shared forge host handling for GitHub ops.
+#
+# Derives the forge's base URL from GITHUB_SERVER_URL, the GitHub Actions
+# predefined variable set automatically by the runner. It is the direct
+# analogue of CI_SERVER_HOST on the GitLab side, which gitlab-host-validation
+# already uses for the same purpose.
+#
+# The GitHub ops libraries previously matched and stripped a literal
+# https://github.com, so every URL on a GitHub Enterprise host was rejected as
+# malformed — the error named the URL rather than the assumption that produced
+# it.
+#
+# Unlike the GitLab library this does not fail closed when the variable is
+# unset: it falls back to https://github.com, which is exactly the behaviour
+# these scripts had before. Failing closed here would break callers that run
+# outside an Actions job, where GITHUB_SERVER_URL is not defined, for the sake
+# of a case Actions always populates.
+#
+# Callers strip the base as a literal prefix rather than interpolating it into
+# a regular expression, matching what patch 0001 established for the triage
+# library: a server URL carrying regex metacharacters then cannot change what
+# a pattern means.
+#
+# Sourced by the github-*-ops.lib.sh files and inlined by the bundler.
+
+[[ -n "${GITHUB_HOST_VALIDATION_SH_LOADED:-}" ]] && return 0
+GITHUB_HOST_VALIDATION_SH_LOADED=1
+
+if ! declare -F _gha_sanitize >/dev/null 2>&1; then
+  _gha_sanitize() {
+    printf '%s' "$1" | tr -d '\n\r' | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g; s/%/%25/g; s/::/%3A%3A/g'
+  }
+fi
+
+# Base URL of the forge these scripts address, with no trailing slash.
+_github_base_url() {
+  local base="${GITHUB_SERVER_URL:-https://github.com}"
+  base="${base%/}"
+  # A plain https origin and nothing else. A value carrying a path, a query or
+  # credentials would be spliced into URL matching and stripping below, so it
+  # is rejected rather than used.
+  if [[ ! "${base}" =~ ^https://[a-zA-Z0-9.-]+(:[0-9]+)?$ ]]; then
+    echo "ERROR: GITHUB_SERVER_URL is not a plain https origin: $(_gha_sanitize "${base}")" >&2
+    return 1
+  fi
+  printf '%s' "${base}"
+}
+
+# Strip the forge's base URL from the front of a URL. Uses parameter expansion
+# rather than sed so that a host needs no regular-expression quoting.
+_github_strip_base() {
+  local url="$1" base
+  base="$(_github_base_url)" || return 1
+  printf '%s' "${url#"${base}/"}"
+}
+# END bundled: lib/github-host-validation.lib.sh
 
 # --- URL handling ---
 
 forge_validate_issue_url() {
-  if [[ ! "${ISSUE_URL}" =~ ^https://github\.com/[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+/issues/[0-9]+$ ]]; then
+  local base rest
+  base="$(_github_base_url)" || return 1
+  rest="${ISSUE_URL#"${base}/"}"
+  if [[ "${rest}" == "${ISSUE_URL}" ]] || \
+     [[ ! "${rest}" =~ ^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+/issues/[0-9]+$ ]]; then
     echo "ERROR: ISSUE_URL does not match expected pattern: $(_gha_sanitize "${ISSUE_URL}")" >&2
     return 1
   fi
 }
 
 forge_parse_issue_url() {
-  REPO=$(echo "${ISSUE_URL}" | sed 's|https://github.com/||; s|/issues/.*||')
+  local rest
+  rest="$(_github_strip_base "${ISSUE_URL}")" || return 1
+  REPO="${rest%%/issues/*}"
   ISSUE_NUMBER=$(basename "${ISSUE_URL}")
 }
 
