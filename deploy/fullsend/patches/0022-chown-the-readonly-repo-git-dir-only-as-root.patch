@@ -6211,6 +6206,26 @@ func outputDirExcludeRel(hostRepositoryDir, outputBase string) (string, bool) {
 // excludeAgentWorkingDirs adds agent working directory patterns to
 // .git/info/exclude so they are invisible to git status and git add.
 // extra holds layout-specific patterns (e.g. host output/ when nested).
+// readonlyRepoCommand returns the shell command that makes the target repo
+// read-only while leaving .git/ writable, so git operations (index.lock,
+// etc.) still work. -prune skips .git traversal entirely; -not -type l
+// prevents symlink traversal.
+//
+// The chown hands .git/ to the sandbox user (run_as_user) after a root-owned
+// extraction, so it runs only when the exec user is root. A non-root exec
+// user already owns what it extracted, and cannot chown without
+// CAP_CHOWN: OpenShell's Kubernetes driver runs the sandbox as a
+// non-root UID with every capability dropped, so an unconditional chown
+// failed there and with it every readonly_repo harness.
+func readonlyRepoCommand(dir string) string {
+	return fmt.Sprintf(
+		"find %[1]s -path '*/.git' -prune -o -not -type l -exec chmod a-w {} + && "+
+			"{ [ \"$(id -u)\" != 0 ] || chown -R sandbox:sandbox %[1]s/.git; } && "+
+			"chmod -R u+w %[1]s/.git",
+		dir,
+	)
+}
