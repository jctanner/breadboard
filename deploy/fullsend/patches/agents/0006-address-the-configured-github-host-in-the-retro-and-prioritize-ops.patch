Subject: fix(agents): address the configured GitHub host in the retro and prioritize ops

Patches 0001 and 0005 made the triage, review, code and fix ops libraries
derive the forge from GITHUB_SERVER_URL. The retro and prioritize libraries
still match and strip a literal https://github.com, so both stages fail on
any GitHub Enterprise install before the agent starts:

  ERROR: ORIGINATING_URL does not match expected pattern: https://forge.internal/acme/widgets/pull/1

github-retro-ops validates and parses ORIGINATING_URL (an issue or a pull
request); github-prioritize-ops does the same for ISSUE_URL. Both now use
_github_base_url and _github_strip_base from github-host-validation.lib.sh,
as the other libraries do: the base is stripped as a literal prefix and
never interpolated into a pattern, a URL on any other host is rejected, and
with GITHUB_SERVER_URL unset the behaviour on github.com is unchanged.

scripts/github-host-validation-test.sh gains cases for both libraries:
github.com defaults, enterprise hosts with and without a port, another host
and a lookalike host. The bundled pre-/post-retro and pre-/post-prioritize
scripts are regenerated with make script-build and verified with make
check-bundle; the existing retro and prioritize script tests still pass.

Breadboard note: applied to the agents mirror by
deploy/fullsend/seed/seed-upstream-agents.py, after 0005, which it depends
on for github-host-validation.lib.sh. Found by Fullsend's behaviour suite
(retro-cel-route.feature) running against the GitHub emulator. Written to be
sent upstream together with 0005. Add a DCO sign-off before submitting it as
a human-authored change.

diff --git a/scripts/github-host-validation-test.sh b/scripts/github-host-validation-test.sh
index 16f68b4c..e3b0c740 100755
--- a/scripts/github-host-validation-test.sh
+++ b/scripts/github-host-validation-test.sh
@@ -143,6 +143,52 @@ check "push-remote-default-is-dotcom" \
       git() { [[ "$1 $2" == "remote set-url" ]] && printf "%s" "$4"; }
       forge_set_push_remote TOK')"
 
+# --- The retro and prioritize libraries ------------------------------------
+
+# Each library on its own: prioritize defines forge_validate_issue_url too, so
+# it cannot share a shell with the code library.
+run_lib() {
+  local lib="$1" server_url="$2" body="$3"
+  (
+    if [[ -n "${server_url}" ]]; then
+      export GITHUB_SERVER_URL="${server_url}"
+    else
+      unset GITHUB_SERVER_URL
+    fi
+    # shellcheck source=/dev/null
+    source "${SCRIPT_DIR}/lib/${lib}"
+    eval "${body}"
+  )
+}
+
+check "retro-default-parses-dotcom-pr" "o/r 7" \
+  "$(run_lib github-retro-ops.lib.sh "" \
+     'ORIGINATING_URL=https://github.com/o/r/pull/7; forge_validate_originating_url && forge_parse_originating_url; echo "${ORIGINATING_REPO} ${ORIGINATING_NUMBER}"')"
+
+check "retro-enterprise-parses-pr" "o/r 7" \
+  "$(run_lib github-retro-ops.lib.sh "https://github.example.org" \
+     'ORIGINATING_URL=https://github.example.org/o/r/pull/7; forge_validate_originating_url && forge_parse_originating_url; echo "${ORIGINATING_REPO} ${ORIGINATING_NUMBER}"')"
+
+check "retro-enterprise-parses-issue" "o/r 12" \
+  "$(run_lib github-retro-ops.lib.sh "https://github.example.org" \
+     'ORIGINATING_URL=https://github.example.org/o/r/issues/12; forge_validate_originating_url && forge_parse_originating_url; echo "${ORIGINATING_REPO} ${ORIGINATING_NUMBER}"')"
+
+check_fails "retro-enterprise-rejects-other-host" \
+  run_lib github-retro-ops.lib.sh "https://github.example.org" \
+    'ORIGINATING_URL=https://github.com/o/r/pull/7; forge_validate_originating_url'
+
+check "prioritize-default-parses-dotcom-issue" "o/r 12" \
+  "$(run_lib github-prioritize-ops.lib.sh "" \
+     'ISSUE_URL=https://github.com/o/r/issues/12; forge_validate_issue_url && forge_parse_issue_url; echo "${REPO} ${ISSUE_NUMBER}"')"
+
+check "prioritize-enterprise-parses-issue" "o/r 12" \
+  "$(run_lib github-prioritize-ops.lib.sh "https://github.example.org:8443" \
+     'ISSUE_URL=https://github.example.org:8443/o/r/issues/12; forge_validate_issue_url && forge_parse_issue_url; echo "${REPO} ${ISSUE_NUMBER}"')"
+
+check_fails "prioritize-rejects-lookalike-host" \
+  run_lib github-prioritize-ops.lib.sh "https://github.example.org" \
+    'ISSUE_URL=https://githubXexample.org/o/r/issues/12; forge_validate_issue_url'
+
 if [[ ${FAILURES} -gt 0 ]]; then
   echo "${FAILURES} test(s) failed"
   exit 1
