 	"strings"
 	"syscall"
 	"time"
@@ -99,9 +100,43 @@ func NewTestPolicy(tlsConfig *tls.Config, allowedDomains, allowedPorts []string)
 	}
 }
 
-// DefaultPolicy is a sensible default policy allowing GitHub content hosts.
+// defaultAllowedDomains returns the hosts a fetch may reach by default:
+// GitHub's own content hosts, plus the forge this process is configured
+// against.
+//
+// An enterprise install has no raw.githubusercontent.com. It serves repository
+// content from its own hostname, so a policy naming only github.com's hosts
+// blocks every fetch there, including the agent harnesses the run needs.
+// GITHUB_SERVER_URL is the standard Actions variable naming that host, and the
+// CLI already reads it and GITHUB_API_URL elsewhere to decide where the forge
+// is; this keeps the allowlist consistent with that choice rather than
+// widening it independently.
+func defaultAllowedDomains() []string {
+	domains := []string{"github.com", "raw.githubusercontent.com"}
+	server := strings.TrimSpace(os.Getenv("GITHUB_SERVER_URL"))
+	if server == "" {
+		return domains
+	}
+	parsed, err := url.Parse(server)
+	if err != nil {
+		return domains
+	}
+	host := strings.ToLower(parsed.Hostname())
+	if host == "" {
+		return domains
+	}
+	for _, existing := range domains {
+		if existing == host {
+			return domains
+		}
+	}
+	return append(domains, host)
+}
+
+// DefaultPolicy is a sensible default policy allowing GitHub content hosts
+// and the configured forge.
 var DefaultPolicy = FetchPolicy{
-	AllowedDomains: []string{"github.com", "raw.githubusercontent.com"},
+	AllowedDomains: defaultAllowedDomains(),
 	MaxSizeBytes:   10 * 1024 * 1024, // 10 MB
 	Timeout:        30 * time.Second,
 	// MaxRetries: nil → uses default (4 total attempts).
