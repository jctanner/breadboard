diff --git a/internal/cli/github_client_test.go b/internal/cli/github_client_test.go
index 441fcd2..7a9d116 100644
--- a/internal/cli/github_client_test.go
+++ b/internal/cli/github_client_test.go
@@ -230,3 +230,23 @@ func TestCLIGitHubAuth_NoDirectCredentialReads(t *testing.T) {
 	assert.Empty(t, violations,
 		"CLI command files must not read GitHub credentials directly; use resolveGitHubToken or newAuthenticatedGitHubClient")
 }
+
+// The github setup/set/status/uninstall/sync-scaffold commands addressed
+// api.github.com by name, so on an enterprise install or an emulator they
+// left the appliance and were refused with credentials meant for somewhere
+// else. They now build their client the same way every other command does.
+func TestGitHubCommandsHonourTheConfiguredAPIURL(t *testing.T) {
+	t.Setenv("GITHUB_API_URL", "https://github.local/api/v3")
+	client := newGitHubLiveClient("token", "")
+	if got := client.BaseURL(); got != "https://github.local/api/v3" {
+		t.Fatalf("BaseURL() = %q, want the configured API URL", got)
+	}
+}
+
+func TestGitHubClientStillDefaultsToThePublicAPI(t *testing.T) {
+	t.Setenv("GITHUB_API_URL", "")
+	client := newGitHubLiveClient("token", "")
+	if got := client.BaseURL(); got != "" && got != "https://api.github.com" {
+		t.Fatalf("BaseURL() = %q, want the client default on github.com", got)
+	}
+}
