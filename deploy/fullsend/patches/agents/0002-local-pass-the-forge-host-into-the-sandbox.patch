index d41762b..8eb1608 100644
--- a/harness/code.yaml
+++ b/harness/code.yaml
@@ -112,6 +112,12 @@ overlays:
         ISSUE_NUMBER: "${ISSUE_NUMBER}"
         ISSUE_URL: "${GITHUB_ISSUE_URL}"
         FULLSEND_FORGE: github
+        # Breadboard-local: gh reads its host from GH_HOST, and for any host
+        # that is not github.com its credential from GH_ENTERPRISE_TOKEN. The
+        # token arrives as a provider placeholder (see the github-ro and
+        # github-code provider definitions); only the host, which is not a
+        # secret, is passed through here.
+        GH_HOST: "${GH_HOST}"
   - when: 'runtime.forge == "gitlab"'
     providers:
       - providers/gitlab-code.yaml
