@@ -5230,6 +5230,39 @@ func remintAgentTokenForPostScript(ctx context.Context, h *harness.Harness, mint
 	return cleanup
 }
 
+// ghEnterpriseTokenVars returns the environment variables gh reads a
+// credential from for this run's forge, or nil when that forge is github.com.
+//
+// gh chooses the variable by host: GH_TOKEN and GITHUB_TOKEN for github.com,
+// GH_ENTERPRISE_TOKEN and GITHUB_ENTERPRISE_TOKEN for everything else. On a
+// GitHub Enterprise Server install, setting GH_TOKEN alone therefore changes
+// nothing gh will read, and whatever the environment already carries in
+// GH_ENTERPRISE_TOKEN stays in charge. A run that mints a narrowly scoped
+// token then keeps calling the forge with the ambient credential the mint was
+// supposed to replace, and nothing in the log distinguishes the two.
+//
+// GH_HOST is consulted first because gh itself prefers it; GITHUB_SERVER_URL
+// is the standard Actions variable naming the host the workflow runs against.
+func ghEnterpriseTokenVars() []string {
+	host := strings.TrimSpace(os.Getenv("GH_HOST"))
+	if host == "" {
+		server := strings.TrimSpace(os.Getenv("GITHUB_SERVER_URL"))
+		if server == "" {
+			return nil
+		}
+		host = server
+		if parsed, err := url.Parse(server); err == nil && parsed.Host != "" {
+			host = parsed.Host
+		}
+	}
+	// Host may carry a port, which is not part of the name being matched.
+	host = strings.ToLower((&url.URL{Host: host}).Hostname())
+	if host == "" || host == "github.com" || strings.HasSuffix(host, ".github.com") {
+		return nil
+	}
+	return []string{"GH_ENTERPRISE_TOKEN", "GITHUB_ENTERPRISE_TOKEN"}
+}
