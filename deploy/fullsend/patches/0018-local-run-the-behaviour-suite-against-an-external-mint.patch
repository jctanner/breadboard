diff --git a/pkg/behaviourtest/drivers/install/repopool_external_mint.go b/pkg/behaviourtest/drivers/install/repopool_external_mint.go
index 272a2b252..9004288f6 100644
--- a/pkg/behaviourtest/drivers/install/repopool_external_mint.go
+++ b/pkg/behaviourtest/drivers/install/repopool_external_mint.go
@@ -8,6 +8,7 @@ import (
 	"context"
 	"fmt"
 	"os"
+	"strings"
 
 	"github.com/fullsend-ai/fullsend/pkg/behaviourtest/drivers/install/common"
 )
@@ -17,7 +18,8 @@ import (
 // the pool uses that mint, which must already enroll the pool's slot
 // repos; nothing is deployed and teardown is a no-op.
 //
-// The mint URL is read from FULLSEND_MINT_URL.
+// The mint URL is read from FULLSEND_MINT_URL; see externalMintSetupOpts
+// for how each slot is installed.
 func NewRepoPoolExternalMint(pool PoolConfig) (Driver, error) {
 	if err := pool.validate(); err != nil {
 		return nil, fmt.Errorf("external mint factory: %w", err)
@@ -29,9 +31,26 @@ func NewRepoPoolExternalMint(pool PoolConfig) (Driver, error) {
 	newMint := func(mintGroup, orgCredential) (mintDriver, func(), error) {
 		return &externalMintDriver{mintURL: mintURL}, func() {}, nil
 	}
+	return buildPoolDriver(pool, nil, newMint, externalMintSetupOpts(), traceStart{})
+}
+
+// externalMintSetupOpts is how each slot is installed against an external
+// mint, chosen the way the CI environments choose it: vendored by default,
+// as dev installs the build under test, or non-vendored at
+// BEHAVIOUR_FULLSEND_REF when that is set, as stage installs main. When
+// BEHAVIOUR_APP_SET is set, setup names that App set, the one the mint was
+// configured with; unset, setup keeps the CLI's default as before.
+func externalMintSetupOpts() common.GitHubSetupOpts {
 	opts := common.DefaultGitHubSetupOpts()
+	if ref := strings.TrimSpace(os.Getenv("BEHAVIOUR_FULLSEND_REF")); ref != "" {
+		opts.Vendor = false
+		opts.FullsendRef = ref
+	}
+	if appSet := strings.TrimSpace(os.Getenv("BEHAVIOUR_APP_SET")); appSet != "" {
+		opts.AppSet = appSet
+	}
 	opts.ConfigPreset = envConfigPreset()
-	return buildPoolDriver(pool, nil, newMint, opts, traceStart{})
+	return opts
 }
 
 // Compile-time check: NewRepoPoolExternalMint satisfies Factory.
diff --git a/pkg/behaviourtest/drivers/install/repopool_external_mint_test.go b/pkg/behaviourtest/drivers/install/repopool_external_mint_test.go
index 752dd4bfc..be19a8f52 100644
--- a/pkg/behaviourtest/drivers/install/repopool_external_mint_test.go
+++ b/pkg/behaviourtest/drivers/install/repopool_external_mint_test.go
@@ -53,3 +53,39 @@ func TestNewRepoPoolExternalMint_HappyPath(t *testing.T) {
 	require.NoError(t, err)
 	assert.Equal(t, "https://mint.test", env.mintURL)
 }
+
+func TestExternalMintSetupOpts_VendoredByDefault(t *testing.T) {
+	t.Setenv("BEHAVIOUR_FULLSEND_REF", "")
+	t.Setenv("BEHAVIOUR_APP_SET", "")
+	t.Setenv("BEHAVIOUR_CONFIG_PRESET", "")
+
+	opts := externalMintSetupOpts()
+	assert.True(t, opts.Vendor)
+	assert.Empty(t, opts.FullsendRef)
+	assert.Empty(t, opts.AppSet, "an unset app set keeps the CLI default")
+}
+
+func TestExternalMintSetupOpts_FullsendRefInstallsNonVendored(t *testing.T) {
+	t.Setenv("BEHAVIOUR_FULLSEND_REF", " main ")
+	t.Setenv("BEHAVIOUR_APP_SET", "fullsend")
+	t.Setenv("BEHAVIOUR_CONFIG_PRESET", "preset.yaml")
+
+	opts := externalMintSetupOpts()
+	assert.False(t, opts.Vendor)
+	assert.Equal(t, "main", opts.FullsendRef)
+	assert.Equal(t, "fullsend", opts.AppSet)
+	assert.Equal(t, "preset.yaml", opts.ConfigPreset)
+}
+
+func TestPoolLayoutForEnvironment_ExternalIsOneOrg(t *testing.T) {
+	t.Setenv("BEHAVIOUR_POOL_SIZE", "3")
+	layout := PoolLayoutForEnvironment("external", nil)
+	assert.Equal(t, []string{StageOrg}, layout.Orgs())
+	assert.Len(t, layout.Slots(), 3)
+
+	// The external factory accepts that layout.
+	t.Setenv("FULLSEND_MINT_URL", "https://mint.test")
+	d, err := NewRepoPoolExternalMint(testPoolConfig(t, layout))
+	require.NoError(t, err)
+	assert.Equal(t, 3, d.Capacity())
+}
